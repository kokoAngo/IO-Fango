FANGO_DB_PATH=./data/fango.db
FANGO_HTTP=0
FANGO_AGENT_KEY=
FANGO_MCP_ALLOWED_HOSTS=localhost,127.0.0.1
FANGO_HOST=127.0.0.1
FANGO_PORT=8000
# Absolute URL prefix for image links returned by MCP tools. Set this in
# production (e.g. https://fango.example.com) so agents return clickable
# URLs to the owner. Leave blank in dev to return relative paths.
FANGO_PUBLIC_BASE_URL=
NOTION_TOKEN=
NOTION_LISTINGS_DATABASE_ID=
# 売買 (sale) listings DB — ingest with `python -m scripts.ingest_notion --sale`.
# Sale rows are only recommended while 取引状況 = 公開中.
NOTION_SALE_DATABASE_ID=

# Consult tool — server-side natural-language advisor (Gemini).
# Without an API key the engine falls back to heuristic responses.
GEMINI_API_KEY=gen-lang-client-0744629526
FANGO_CONSULT_MODEL=gemini-2.5-flash
FANGO_CONSULT_MAX_TURNS=10
FANGO_CONSULT_SESSION_TTL_SEC=86400
FANGO_CONSULT_HISTORY_COMPRESS_AFTER=3

# IPs that bypass the per-IP rate cap on public read pages (SSR listing,
# image endpoint, forum index). Use it for the owner / staff browsing
# their own site so debugging refreshes don't lock you out. Comma-separated.
FANGO_PUBLIC_READ_IP_ALLOWLIST=

# Image-less listings: let the server find a matching SUUMO/HOMES page by
# building name and unfurl its OGP image into a preview card on proposals.
# Off by default (it scrapes third-party search HTML — brittle & ToS-sensitive,
# cached + rate-limited when on). Set to 1 in production to enable.
FANGO_EXTERNAL_LOOKUP_ENABLED=0
# Optional UA override for those outbound fetches.
FANGO_EXTERNAL_LOOKUP_UA=

# Blockchain anchoring of finalized agreements (optional, OFF by default).
# Without all three of RPC URL + private key + contract address, agreements are
# still created off-chain and anchoring is silently skipped.
# WARNING: FANGO_CHAIN_PRIVATE_KEY controls real funds — keep it out of git/logs,
# inject via a secret manager in prod, and use a testnet key while developing.
FANGO_CHAIN_RPC_URL=
FANGO_CHAIN_PRIVATE_KEY=
FANGO_CHAIN_CONTRACT_ADDR=
FANGO_CHAIN_ID=11155111
FANGO_CHAIN_CONFIRMATIONS=1
FANGO_CHAIN_CONFIRM_TIMEOUT_SEC=180
