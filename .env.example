FANGO_DB_PATH=./data/fango.db
FANGO_HTTP=0
FANGO_AGENT_KEY=
FANGO_MCP_ALLOWED_HOSTS=localhost,127.0.0.1
FANGO_HOST=127.0.0.1
FANGO_PORT=8000
# Absolute URL prefix for image links returned by MCP tools. Set this in
# production (e.g. https://fango.example.com) so agents return clickable
# URLs to the owner. Leave blank in dev to return relative paths.
FANGO_PUBLIC_BASE_URL=
NOTION_TOKEN=
NOTION_LISTINGS_DATABASE_ID=

# Consult tool — server-side natural-language advisor (Gemini).
# Without an API key the engine falls back to heuristic responses.
GEMINI_API_KEY=gen-lang-client-0744629526
FANGO_CONSULT_MODEL=gemini-2.5-flash
FANGO_CONSULT_MAX_TURNS=10
FANGO_CONSULT_SESSION_TTL_SEC=86400
FANGO_CONSULT_HISTORY_COMPRESS_AFTER=3

# IPs that bypass the per-IP rate cap on public read pages (SSR listing,
# image endpoint, forum index). Use it for the owner / staff browsing
# their own site so debugging refreshes don't lock you out. Comma-separated.
FANGO_PUBLIC_READ_IP_ALLOWLIST=
